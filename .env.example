# Optional — the site builds and runs without any of these.
# They are only needed for the /admin evidence upload page.

# Vercel Blob read/write token. Created automatically when you add Blob
# storage to the project: Vercel dashboard -> Storage -> Create -> Blob.
BLOB_READ_WRITE_TOKEN=

# Password for /admin. Use something long and random. This protects the
# upload form only; nothing else on the site is gated.
ADMIN_PASSWORD=

# Optional: override the canonical URL. On Vercel this is derived from
# VERCEL_PROJECT_PRODUCTION_URL automatically. Set it if you attach a
# custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
